# Port the server listens on (Railway sets this automatically)
PORT=3000

# Directory for the SQLite database and uploaded photos.
# On Railway, mount a Volume and point this at it, e.g. /data
DATA_DIR=./data

# Secret used to sign session cookies. MUST be set to a long random string
# in production. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL used when generating QR codes / invite links.
# Leave empty to derive it from the incoming request.
# Example: https://foto.konradthiemann.de
PUBLIC_BASE_URL=

# Days after creation before an event and its whole gallery are auto-deleted
# (DSGVO storage limitation). Default 30.
RETENTION_DAYS=30

# Token that unlocks the global admin dashboard at /admin. Leave empty to keep
# the admin API disabled. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# --- Host info email (sent after event creation) ---
# Transport is picked in order: SMTP (if SMTP_* set) → Resend (if key set) → console log (dev).
#
# Option A — Gmail SMTP. NOTE: Railway blocks outbound SMTP on Free/Trial/Hobby
# plans — this only works on Railway Pro+. Needs 2FA + a 16-char Google App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx        # 16-char Google App Password (NOT your normal password)
# EMAIL_FROM=Knips <you@gmail.com>
#
# Option B — Resend HTTPS API. Works on ANY Railway plan; needs a domain
# verified in Resend (DKIM/SPF DNS records at your DNS provider):
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Knips <noreply@your-domain>
